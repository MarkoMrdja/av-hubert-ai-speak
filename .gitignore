# === Data (licensed / huge — NEVER push) ===
# Anchored to repo-root /data/ only — must NOT match vendored av_hubert/**/data/ dirs.
/data/
*.mp4
*.wav
*.npz
*.parquet
*.tar
*.tar.gz
*.tar.xz

# === Model checkpoints & binaries (huge) ===
workspace/checkpoints/
*.pt
*.dat
*.bz2
workspace/experiments/*/checkpoint_*.pt
# keep experiment LOGS + decode results (small, useful for the report):
!workspace/experiments/**/train.log
!workspace/experiments/**/*.log
!workspace/experiments/**/*.json
!workspace/experiments/**/wer.*
!workspace/experiments/**/.hydra/**

# === Vendored upstream (av_hubert @ 258fb50 + fairseq @ afc77bd) ===
# Meta's av_hubert + fairseq are vendored (committed directly, MIT-licensed),
# with our LoRA change applied in avhubert/hubert_asr.py. See av_hubert/PROVENANCE.md.
# Only ignore local build artifacts inside it:
av_hubert/**/__pycache__/
av_hubert/**/*.egg-info/

# === Personal / local-only (guides, infra notes, doc generators) ===
# Kept on disk, never pushed. Anchored to repo-root /local/ (not vendored subdirs).
/local/

# === Runpod / local artifacts ===
workspace/RUNPOD_POD_INFO.txt
scratchpad/
*.pyc
__pycache__/
.DS_Store
node_modules/

# === conda/pip local ===
*.egg-info/
.vscode/
