# === The upstream repo is a pinned git SUBMODULE (see .gitmodules) ===
# We do NOT vendor its files; the submodule records the exact commit.
# Our LoRA change lives in our_code_changes/ and is applied on top.
# Ignore local build artifacts inside it:
av_hubert/**/__pycache__/
av_hubert/**/*.egg-info/
av_hubert/requirements-frozen-macos-arm64.txt

